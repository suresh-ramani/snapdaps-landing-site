# Public site URL (no trailing slash) — used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://www.snapdaps.ai

# Headless WordPress
WP_URL=https://cms.snapdaps.ai
WP_GRAPHQL_URL=https://cms.snapdaps.ai/graphql
# Set to "yoast" if WPGraphQL for Yoast SEO is installed (pulls SEO title/description from WP)
WP_SEO_PLUGIN=yoast

# Shared secret for the WordPress → Next.js revalidation webhook and draft previews
REVALIDATE_SECRET=change-me
PREVIEW_SECRET=change-me-too

# WordPress application password (Users → Profile → Application Passwords), only needed for draft previews
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=

# How long WordPress data stays in the Next.js data cache (seconds). Pages are still SSR on every request.
WP_CACHE_SECONDS=300

# Book-a-demo / contact form → email (https://resend.com). Without a key, requests are only logged.
RESEND_API_KEY=
# Comma-separated inbox(es) that receive demo requests
DEMO_INBOX=
# Sender on a domain verified in Resend
DEMO_FROM=Snapdaps website <website@snapdaps.ai>
